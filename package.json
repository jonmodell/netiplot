{
  "name": "revis-network-ts",
  "version": "0.0.3",
  "description": "React network visualization library",
  "author": "Jon Modell<jon@jonmodell.com>",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonmodell/revis-network-ts"
  },
  "keywords": [
    "React",
    "Component",
    "Network",
    "Visualization",
    "Graph",
    "Library"
  ],
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.esm.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.esm.js",
      "require": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "@types/react": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.4.0",
    "vite": "^6.4.1",
    "vite-plugin-dts": "^3.9.0"
  },
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf lib node_modules",
    "dev": "npm --prefix demo run dev",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch"
  }
}
