{
  "name": "@jonmodell/netiplot",
  "version": "2.0.3",
  "description": "Netiplot network visualization library",
  "author": "Jon Modell<jon@jonmodell.com>",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonmodell/netiplot"
  },
  "keywords": [
    "React",
    "Component",
    "Network",
    "Visualization",
    "Graph",
    "Library"
  ],
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.esm.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.esm.js",
      "require": "./lib/index.js"
    },
    "./vanilla": {
      "types": "./lib/vanilla.d.ts",
      "import": "./lib/vanilla.esm.js",
      "require": "./lib/vanilla.js"
    },
    "./styles": "./lib/netiplot.css"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "semantic-release": "^25.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/git": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^6.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vite-plugin-dts": "^5.0.0"
  },
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf lib node_modules",
    "dev": "npm --prefix demo run dev",
    "dev:react": "npm --prefix demo-react run dev",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch"
  }
}
